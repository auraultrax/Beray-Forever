# Add these in Supabase Dashboard > Edge Functions > Secrets.
# Generate the values locally; never commit the real values.
# Example generation: openssl rand -hex 32
IP_LOG_ENCRYPTION_KEY=replace_with_64_hex_characters
IP_HASH_SECRET=replace_with_a_long_random_secret
# Comma-separated exact origins, e.g. https://your-domain.example
CORS_ORIGINS=https://your-forever-domain.example
