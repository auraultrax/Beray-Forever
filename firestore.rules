rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Yönetici: yalnızca doğrulanmış bu e-posta. Gerçek e-postayı SADECE Firebase Console'daki kurala yaz
    // (bu depo herkese açık; gerçek adresi buraya/GitHub'a yazma).
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'ADMIN_EMAIL_BURAYA';
    }

    // Askıda / yasaklı / kısıtlı hesap hiçbir şey yazamaz
    function isBlocked() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) == true
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == true
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('restrictedUntil', 0) > request.time.toMillis()
      );
    }

    // Moderasyon + yetki alanları: sahibi dokunamaz (role dahil: kimse kendini yönetici yapamaz)
    function modFields() {
      return ['suspended','suspendedReason','suspendedMessage','suspendedAt','suspendedBy',
              'banned','restrictedUntil','restrictedReason','warnCount','lastWarning','role'];
    }
    function touchesMod() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(modFields());
    }

    function isValidUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 24
        && name.matches('^[a-z0-9_]+$');
    }
    function isValidPostContent(c) { return c is string && c.size() <= 2000; }

    // Yönetici işlem kayıtları (değiştirilemez, silinemez)
    match /modlogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin()
                    || isOwner(userId)
                    && !request.resource.data.keys().hasAny(modFields())
                    && isValidUsername(request.resource.data.username)
                    && request.resource.data.uid == userId;
      allow update: if isAdmin()
                    || (isOwner(userId) && !touchesMod()
                        && (!('username' in request.resource.data)
                            || isValidUsername(request.resource.data.username)))
                    // başkası yalnızca takipçi listesini değiştirebilir
                    || (isSignedIn() && !isBlocked()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']));
      allow delete: if isOwner(userId) && !isBlocked();
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && !isBlocked() && isValidUsername(username)
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBlocked()
                    && request.resource.data.userId == request.auth.uid
                    && isValidPostContent(request.resource.data.content)
                    && request.resource.data.keys().hasAll(['userId', 'authorName', 'content', 'createdAt']);
      allow update: if isSignedIn() && !isBlocked() && (
                      resource.data.userId == request.auth.uid
                      || request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['likes', 'comments', 'likeCount', 'sparks', 'poll'])
                    );
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBlocked()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) && !isBlocked();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.blockerId == request.auth.uid
                    && request.resource.data.blockedId != request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && !isBlocked()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 500;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow create: if isSignedIn() && (isAdmin() || !isBlocked());
      allow read, update: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.toUid == request.auth.uid;
    }

    // Doğum tarihi ve benzeri hassas profil bilgileri: yalnızca hesap sahibi.
    match /privateProfiles/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Odalar: herkese açık odalar keşfedilebilir; yazışma yalnızca üyeye açık.
    match /rooms/{roomId} {
      allow read: if resource.data.visibility == 'public'
                  || (isSignedIn() && request.auth.uid in resource.data.memberUids);
      allow create: if isSignedIn() && !isBlocked()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.visibility == 'public'
                    && request.resource.data.memberUids is list
                    && request.resource.data.memberUids.size() == 1
                    && request.auth.uid in request.resource.data.memberUids
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 3
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 160;
      // Üye katılımı dışında oda üyelik listesini istemci değiştiremez.
      allow update: if isSignedIn() && !isBlocked()
                    && resource.data.visibility == 'public'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
                    && request.resource.data.memberUids is list
                    && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
                    && request.resource.data.memberUids.size() <= 100
                    && request.resource.data.memberUids.hasAll(resource.data.memberUids)
                    && !(request.auth.uid in resource.data.memberUids)
                    && request.auth.uid in request.resource.data.memberUids;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /messages/{messageId} {
        function isRoomMember() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/rooms/$(roomId))
            && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;
        }
        allow read: if isRoomMember();
        allow create: if isRoomMember() && !isBlocked()
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.senderName is string
                      && request.resource.data.senderName.size() <= 40
                      && request.resource.data.text is string
                      && request.resource.data.text.size() >= 1
                      && request.resource.data.text.size() <= 1000
                      && request.resource.data.keys().hasAll(['senderUid','senderName','text','createdAt']);
        allow update: if false;
        allow delete: if isAdmin()
                      || (isRoomMember() && resource.data.senderUid == request.auth.uid);
      }
    }

    // Kullanılmayan koleksiyonlar kapalı
    match /{document=**} { allow read, write: if false; }
  }
}
